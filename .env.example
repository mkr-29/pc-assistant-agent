# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MY_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_MODE=polling
WEBHOOK_URL=
PORT=3000

# Gemini API Configuration (primary model: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq fallback used when Gemini 2.5 Flash fails
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Inception Labs fallback used when Groq also fails
INCEPTION_API_KEY=your_inception_api_key_here
INCEPTION_MODEL=mercury-2
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Optional Gemini model used for screenshot/screen understanding
SCREEN_ANALYSIS_MODEL=gemini-2.5-flash

# Optional Telegram voice-note transcription settings
VOICE_TRANSCRIPTION_MODEL=gemini-2.5-flash
VOICE_NOTE_MAX_BYTES=18000000

# Optional managed browser automation settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SCREENSHOT_DIR=.data/browser-screenshots

# Default workspace for relative file paths and terminal commands
TARGET_PROJECT_PATH=.

# Safer command approvals
SAFER_COMMAND_APPROVALS_ENABLED=true
APPROVAL_TIMEOUT_MS=300000
MANY_FILE_WRITE_APPROVAL_THRESHOLD=5

# Azure OpenAI Configuration (legacy; not used by default request execution)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2024-08-01-preview
