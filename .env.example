# Telegram configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MY_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
INCEPTION_API_KEY=your_inception_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
ARCEE_API_KEY=your_arcee_api_key_here
LONGCAT_API_KEY=your_longcat_api_key_here
THINKING_MACHINE_API_KEY=your_thinking_machine_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# Fallback model configurations
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
INCEPTION_MODEL=mercury-2
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
SARVAM_MODEL=sarvam-105b
ARCEE_MODEL=zai-org/glm-5.2
LONGCAT_MODEL=LongCat-2.0
THINKING_MACHINE_MODEL=inkling

# Optional settings
SAFER_COMMAND_APPROVALS_ENABLED=true
APPROVAL_TIMEOUT_MS=300000
MANY_FILE_WRITE_APPROVAL_THRESHOLD=5

# Browser automation settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SCREENSHOT_DIR=.data/browser-screenshots

# Voice note settings
VOICE_TRANSCRIPTION_MODEL=gemini-2.5-flash
VOICE_NOTE_MAX_BYTES=18000000

# Firecrawl settings
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Target project path for relative paths
TARGET_PROJECT_PATH=

# Port for HTTP server
PORT=8080